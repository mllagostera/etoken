<resources>
    <!-- Colours all come from the Compose theme; this only has to keep the
         platform from drawing an action bar or a splash background. -->
    <style name="Theme.Etoken" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        The theme the activity is launched with, and the only one it wears
        before its first frame. `postSplashScreenTheme` is what it is swapped
        for, by installSplashScreen() in MainActivity.onCreate — without that
        call the app would keep this theme and never draw a screen.

        Named under Theme.Etoken for where it belongs, but its parent is the
        library's: Theme.SplashScreen is what carries the three attributes
        below to Android 8 through 11, where there is no platform splash to
        configure and the icon has to be drawn into the starting window.

        No values-night variant on purpose. The background is fixed (see
        colors.xml) and postSplashScreenTheme resolves per configuration, so a
        phone in dark mode still lands on the dark Theme.Etoken.
    -->
    <style name="Theme.Etoken.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Etoken</item>
        <!-- Dark background, so the clock and the icons beside it have to be light. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
